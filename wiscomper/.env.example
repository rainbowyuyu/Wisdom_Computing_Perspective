# Wiscomper 智算视界：本机或独立部署配置，不要发布真实密钥。
VISUALIZE_PORT=3088
# 留空保持本机模式与noindex。正式上线只填HTTPS域名根地址，无路径/查询/片段。
# 例：https://wiscomper.example.com（替换为自己控制的真实域名）
PUBLIC_SITE_URL=
# GitHub OAuth App：回调必须精确设为 PUBLIC_SITE_URL + /api/auth/github/callback。
# 公网登录使用read:user最小身份权限；Secret只保存在服务端。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 旧站账号：显式选择mysql时直接校验旧users/account_access；连接失败绝不降级本地。
# sqlite为独立本地兼容账户库，固定放在VISUALIZE_DATA目录内的legacy-accounts.sqlite3。
LEGACY_ACCOUNT_BACKEND=sqlite
LEGACY_MYSQL_HOST=
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=
# 邮箱验证/注册/重设使用SMTP TLS；用户名存在时必须配置密码。空值不会发送邮件。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=智算视界
SMTP_USE_TLS=1
# 独立部署请使用安全随机值(至少32字符)；复用旧验证码表时保持旧EMAIL_CODE_SECRET。
EMAIL_CODE_SECRET=
# 公网每个登录账户每日真实模型创作任务上限；匿名用户仅可探索本地示例。
PUBLIC_ACCOUNT_DAILY_TASKS=3
# 每个真实模型任务保守预留3次步骤调用，失败仍计入。按UTC日期更新。
VISUALIZE_DAILY_CALLS=30
# 可选：私有数据保存位置，缺省为本工程data/
# VISUALIZE_DATA=D:/private/visualize-data
# 默认只读CC Switch当前ChatGPT/Claude服务，具体独立覆盖配置见runtime文档。
# 不需要复制CC Switch密钥。以下仅用于部署到没有CC Switch的独立机器；
# 同一模型的MODEL/BASE_URL/API_KEY必须一起设置，不会静默切换提供商。
# VISUALIZATION_CHATGPT_MODEL=your-model-id
# VISUALIZATION_CHATGPT_BASE_URL=https://your-provider.example/v1
# VISUALIZATION_CHATGPT_API_KEY=
# VISUALIZATION_CHATGPT_API=openai-responses
# VISUALIZATION_CHATGPT_EFFORT=low
# VISUALIZATION_CLAUDE_MODEL=your-model-id
# VISUALIZATION_CLAUDE_BASE_URL=https://your-provider.example
# VISUALIZATION_CLAUDE_API_KEY=
# VISUALIZATION_CLAUDE_API=anthropic-messages
# VISUALIZATION_CLAUDE_AUTH=bearer
# VISUALIZATION_CLAUDE_EFFORT=low
# Windows 本机 Qwen 使用全局 DPAPI 密钥，每次调用重新加载。
# Linux 部署沿用旧 .env 的 ALIYUN_KEY，或配置 DASHSCOPE_API_KEY（只填服务器私有配置）。
# 不要复制本机 DPAPI 文件到服务器，也不要把真实密钥放进部署包。
# 文字/公式与图片理解分别选用对应模型，默认北京官方 DashScope。
# VISUALIZATION_QWEN_MODEL=qwen-plus
# VISUALIZATION_QWEN_VISION_MODEL=qwen3-vl-plus
# 可选其他官方区域；必须与密钥所属区域一致，不支持第三方网关。
# VISUALIZATION_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 配置优先级：进程环境 > .env.local > .env > .env.deploy（部署默认值）。
# 保留旧 MYSQL_HOST/PORT/USER/PASSWORD/DB、SOLVER_MODEL、PORT 和 AI_ENABLED 配置。

# 可选工程来源集成：默认关闭，不影响普通文字、公式、图片可视化。
# 配置绝对且专用的来源目录，不允许磁盘根目录；不要把原工程数据发布到 Git。
# 详细格式见 docs/engineering-integration.md。下列设置可放在私有 .env.local。
# WISCOMPER_ENGINEERING_WORKSPACES=/srv/private/engineering-workspaces
# WISCOMPER_ENGINEERING_NATIVE_OUTPUTS=/srv/private/engineering-outputs
# WISCOMPER_ENGINEERING_WORKSPACE_ID=
# WISCOMPER_ENGINEERING_BASIS_PATH=inputs/design-basis.json
# WISCOMPER_ENGINEERING_RELEASE_PATH=reports/release.json
# WISCOMPER_ENGINEERING_REVIEW_PATH=reports/scope.md
# WISCOMPER_ENGINEERING_DEFAULT_CANDIDATE=demo
# WISCOMPER_ENGINEERING_PROFILES_JSON={"demo":{"label":"演示装配来源","kind":"assembly","geometry_path":"geometry/demo/report.json","mesh_path":"geometry/demo/mesh.json"}}
