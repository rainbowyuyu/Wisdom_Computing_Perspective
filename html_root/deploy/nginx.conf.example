# Add these locations INSIDE the BaoTa site's existing server block.
# Keep BaoTa's server_name, TLS certificate and ACME configuration.
# Proxy the website to Python. Do not expose html_root as a static document root.
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    # Preserve the browser-facing port as well as the hostname.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_buffering off;
    proxy_read_timeout 600s;
    client_max_body_size 30m;
}

# Do not let BaoTa's default static-extension regex bypass the Python asset routes.
location ^~ /static/ { proxy_pass http://127.0.0.1:8000; }
location ^~ /assets/ { proxy_pass http://127.0.0.1:8000; }
location ^~ /css/ { proxy_pass http://127.0.0.1:8000; }
location ^~ /js/ { proxy_pass http://127.0.0.1:8000; }
location ^~ /docs/ { proxy_pass http://127.0.0.1:8000; }
location ^~ /videos/ { proxy_pass http://127.0.0.1:8000; }
