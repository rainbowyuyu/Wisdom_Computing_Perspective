# 智算视界环境配置参考
# 新环境：复制为 .env 后填写数据库、模型、邮箱及两个独立签名密钥。
# 已有环境：按需补充，不要覆盖已有 .env 或 .env.local。
# 生效顺序：系统/宝塔环境变量 > .env.local > .env > 程序默认值。
# 修改后重启网站自己的 main.py 项目；不要重启宝塔面板。
# 带空格、# 等字符的值请用引号包裹；本文件不能填写真实密钥后提交 Git。

# ── 1. 网站启动与反向代理 ──
# 本机访问和宝塔 Nginx 反代都用 127.0.0.1；仅明确需要外部直连时改监听地址。
HOST=127.0.0.1
PORT=8000
# 仅信任直接连接网站的代理 IP；代理须覆盖 X-Real-IP / X-Forwarded-* 请求头。
TRUSTED_PROXY_IPS=127.0.0.1,::1
# 完整浏览器来源，多个用逗号分隔，不能填 *；本地同源访问仍可使用。
ALLOWED_ORIGINS=https://www.wiscomper.com

# ── 2. MySQL（填写宝塔中网站数据库的账号） ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=wiscomper_com
MYSQL_USER=your_database_user
MYSQL_PASSWORD='replace_with_database_password'

# ── 3. 大模型与费用保护 ──
ALIYUN_KEY=
SOLVER_MODEL=qwen-plus
# 0 暂停模型服务；本地计算、历史结果阅读仍可用。
AI_ENABLED=1
# 每次上游请求都计入预算，包括自动修复；日预算按 UTC 日期结算。
# 以下是全站服务保护，不是普通用户日额度；用户额度/VIP 在管理员面板设置。
AI_GLOBAL_DAILY_CALLS=300
# 未登录调用的单 IP 日上限；已登录用户仍受全站预算限制。
AI_IP_DAILY_CALLS=80
# 每个调用身份每分钟上限；token 预算使用保守预留，非账单精确计数。
AI_CALLS_PER_MINUTE=6
AI_DAILY_TOKEN_RESERVE=2000000
AI_MAX_OUTPUT_TOKENS=7000
# 模型调用并发（非 Manim 渲染并发）；等待单位为秒，最大 60。
AI_MAX_CONCURRENT=4
AI_USER_CONCURRENT=2
AI_QUEUE_TIMEOUT=60
# 0 使用本地公式标签，保存算式时不额外调用模型。
AI_FORMULA_TAGGING=0

# ── 4. 网页入口与服务器资源保护 ──
API_HTTP_MAX_CONCURRENT=16
API_HTTP_MAX_PER_IP=8
# 受保护操作的单 IP 每分钟请求数；共用公网 IP 的学校需结合监控调整。
API_REQUESTS_PER_MINUTE=30
# 单位 MB：可用内存/磁盘低于此值，暂停新重任务，保留浏览与取消入口。
HOST_MIN_AVAILABLE_MEMORY_MB=256
HOST_MIN_FREE_DISK_MB=512
# 紧急停止线须低于上面的内存准入线，仅终止本站计算/渲染子进程。
HOST_EMERGENCY_AVAILABLE_MEMORY_MB=96
# 小型服务器保持数学与动画各 1 个任务；不要依靠多 worker 增加并发。
MATH_MAX_WORKERS=1
MATH_WORKER_MEMORY_MB=384
MANIM_MAX_CONCURRENT=1
MANIM_WORKER_MEMORY_MB=768
# 内存限制在 Linux 中生效，属于单进程地址空间，不是整站总内存上限。
# 除主账号外可执行自定义 Python 的可信用户名，逗号分隔；留空不额外授权。
WISDOM_CODE_RUNNERS=

# ── 5. 企业邮箱、验证码与找回密码 ──
SMTP_HOST=smtp.exmail.qq.com
# 465 使用隐式 TLS；587 使用 STARTTLS。生产环境保持 SMTP_USE_TLS=1。
SMTP_PORT=465
SMTP_USE_TLS=1
SMTP_USERNAME=noreply@wiscomper.cn
# 填客户端专用授权码；不是网站登录密码。
SMTP_PASSWORD=
SMTP_FROM=noreply@wiscomper.cn
SMTP_FROM_NAME='智算视界'
# 独立随机密钥；修改后已发出但未使用的验证码会失效。
EMAIL_CODE_SECRET=
EMAIL_CODE_EXPIRE_SECONDS=600
EMAIL_SEND_COOLDOWN_SECONDS=60
EMAIL_DAILY_LIMIT=10

# ── 6. 教学视频与可选 CDN ──
# 独立随机密钥，不能与 EMAIL_CODE_SECRET 共用；修改后旧视频签名链接失效。
# 可分别运行两次：python -c "import secrets; print(secrets.token_hex(32))"
VIDEO_TOKEN_SECRET=
# 不用 CDN 保持 0；开启前配置好 CDN 域名、回源及对应鉴权。
EXAMPLES_USE_CDN=0
ALIYUN_CDN_DOMAIN=
ALIYUN_CDN_AUTH_KEY=
ALIYUN_CDN_AUTH_TYPE=a
ALIYUN_CDN_VIDEO_PATH=/storage
ALIYUN_CDN_AUTH_TTL=3600
# 仅在 CDN 允许公开链接时设置；不是存储桶密码或资源包编号。
ALIYUN_CDN_PUBLIC_BASE=

# ── 7. 可选运行记录位置（通常不用修改，不要设置为空） ──
# 默认保存在网站根目录 var/ 中，部署时保留，不能通过网页公开访问。
# USAGE_DB_PATH=/absolute/private/path/usage.sqlite3
# MATH_TASK_DB_PATH=/absolute/private/path/math-tasks.sqlite3
