# Copy to .env.local on your server and enter the database credentials from BaoTa.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=wiscomper_com
MYSQL_USER=your_database_user
MYSQL_PASSWORD=replace_with_database_password
ALIYUN_KEY=
VIDEO_TOKEN_SECRET=replace_with_a_long_random_secret
EXAMPLES_USE_CDN=0

# Global provider budgets: each upstream attempt counts, including retries.
# Personal daily quotas and VIP are configured in the administrator UI (MySQL).
AI_ENABLED=1
AI_IP_DAILY_CALLS=80
AI_GLOBAL_DAILY_CALLS=300
AI_CALLS_PER_MINUTE=6
AI_MAX_CONCURRENT=4
AI_USER_CONCURRENT=2
AI_QUEUE_TIMEOUT=60
AI_MAX_OUTPUT_TOKENS=7000
AI_DAILY_TOKEN_RESERVE=2000000
API_REQUESTS_PER_MINUTE=30
# Tag formulas locally by default, with no hidden model consumption on save.
AI_FORMULA_TAGGING=0
# Exact admin usernames only. Empty disables execution of arbitrary Python.
WISDOM_CODE_RUNNERS=
# Only these immediate reverse proxies may supply X-Real-IP / X-Forwarded-Host / X-Forwarded-Proto.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Optional exact browser origins, including scheme and non-default port; never use *.
# Empty defaults to https://www.wiscomper.com; same-origin local requests also work.
# Example: https://your-domain.example,https://your-domain.example:8443
ALLOWED_ORIGINS=

# 邮箱验证与密码找回（生产环境必须配置；凭据只保存在服务器环境变量）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=智算视界
SMTP_USE_TLS=1
EMAIL_CODE_SECRET=replace_with_a_long_random_secret
EMAIL_CODE_EXPIRE_SECONDS=600
EMAIL_SEND_COOLDOWN_SECONDS=60
EMAIL_DAILY_LIMIT=10
